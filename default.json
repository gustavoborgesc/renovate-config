{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Configuração agressiva: atualiza tudo com auto-merge irrestrito",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergeAll",
    ":automergeBranch"
  ],
  "timezone": "America/Sao_Paulo",
  "schedule": ["at any time"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "branch",
    "ignoreTests": true,
    "schedule": ["before 5am on Monday"]
  },
  "packageRules": [
    {
      "description": "Habilita auto-merge irrestrito para qualquer tipo de atualização em todos os pacotes",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "rollback",
        "bump"
      ],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    }
  ]
}
